# Environment settings (development, production)
DJANGO_ENV=development
DJANGO_SECRET_KEY=change-me-to-a-very-secure-random-key-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (Default development: SQLite, Production: Neon PostgreSQL)
DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgresql://user:password@ep-xyz.neon.tech/neondb?sslmode=require

# CORS allowed origins (Frontend Next.js)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Media & Storage
MEDIA_URL=/media/
MEDIA_ROOT=media/
STATIC_URL=/static/
STATIC_ROOT=staticfiles/
